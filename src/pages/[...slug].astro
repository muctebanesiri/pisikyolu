---
import { toPersianDigits } from "@/lib/localization";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import EpisodeOutline from "@/components/EpisodeOutline.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AudioPlayer from "@/components/AudioPlayer.astro";
import { hisMetadata } from "@/metadata.ts";
import type { ExtractedLink } from "@/markdown/links";
import { formatEpisodeDate, formatEpisodeDateValue } from "@/lib/dates";
import { getEpisodeData, pageTitle, type Episode } from "@/lib/episodes";
import { episodeCard, shareImage } from "@/lib/share-card";
import { getEpisodeAudioSource } from "@/lib/audio";

export async function getStaticPaths() {
  const { episodes } = await getEpisodeData();
  return episodes.map((episode) => ({ params: { slug: episode.slug }, props: { episode } }));
}

interface Props { episode: Episode }

const { episode } = Astro.props;
const { slug, data: frontmatter, number: episodeNumber, related } = episode;
const { title: episodeTitle, guests } = frontmatter;
const { Content, headings: allHeadings, remarkPluginFrontmatter } = await render(episode);
const headings = allHeadings.filter((h) => h.depth === 2);
const extractedLinks = (remarkPluginFrontmatter?.extractedLinks || []) as ExtractedLink[];
const hasBody = Boolean(episode.body?.trim());
const image = shareImage(episodeCard(episode));
const neighbors = [
  { label: "← Previous", episode: episode.previous },
  { label: "Next →", episode: episode.next },
];

const videoUrl = frontmatter.video?.url ?? null;
const videoOffsetSeconds = frontmatter.video?.offsetSeconds ?? 0;

function getYouTubeVideoId(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === "youtu.be") {
      return parsed.pathname.slice(1) || null;
    }
    if (parsed.hostname.includes("youtube.com")) {
      return parsed.searchParams.get("v");
    }
  } catch {
    return null;
  }
  return null;
}

const videoId = videoUrl ? getYouTubeVideoId(videoUrl) : null;
const videoEmbedSrc = videoId
  ? `https://www.youtube-nocookie.com/embed/${videoId}?enablejsapi=1&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&cc_load_policy=0`
  : null;
const hasVideoPlayback = Boolean(videoEmbedSrc && videoUrl);
const audioSource = getEpisodeAudioSource(frontmatter.episodeLink);
const hasLongDescription = hasBody && frontmatter.description.length > 135;
---

<Layout frontmatter={{ title: pageTitle(episode), description: frontmatter.description }} slug={`/${slug}`} image={image} mainId="episode-content-shell">
  <div
    id="episode-shell"
    class="flex flex-col h-screen"
    data-video-mode={hasVideoPlayback ? "read" : undefined}
  >
    {/* Sticky chat header - like DM conversation header */}
    <header
      id="chat-header"
      class="sticky top-0 z-20 bg-his-bg/95 backdrop-blur-sm border-b border-his-hr px-4 py-3 flex flex-col gap-3 transition-shadow duration-200"
      data-video-mode={hasVideoPlayback ? "read" : undefined}
    >
      <div class="episode-header-row w-full flex items-center gap-3 max-[360px]:flex-wrap">
        <a href={`/#ep-${slug}`} class="episode-back" aria-label="All episodes">
          <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 10H4M9 5l-5 5 5 5" />
          </svg>
        </a>
        <div class="episode-header-line flex-1 min-w-0 flex items-baseline gap-x-3">
          <h1 class="truncate text-lg font-semibold leading-tight tracking-tight">{episodeTitle}</h1>
          <div class="episode-header-meta flex items-baseline gap-x-1.5 whitespace-nowrap text-xs text-his-text-tertiary leading-tight">
            {guests.length > 0 && (
              <span class="truncate text-his-text-secondary">{guests.join("، ")}</span>
            )}
            {guests.length > 0 && <span class="text-his-text-secondary">·</span>}
            <span class="ep-badge">{episodeNumber}</span>
            <span class="text-his-text-secondary max-sm:hidden">·</span>
            <time class="max-sm:hidden" datetime={formatEpisodeDateValue(frontmatter.date)}>
              {formatEpisodeDate(frontmatter.date)}
            </time>
            {frontmatter.time && (
              <>
                <span class="text-his-text-secondary max-sm:hidden">·</span>
                <span class="max-sm:hidden">{frontmatter.time}m</span>
              </>
            )}
          </div>
        </div>
        {/* Episode-specific controls align with the shared search/theme controls. */}
        {hasVideoPlayback && (
        <nav class="episode-header-controls flex items-start gap-2 flex-shrink-0 max-[360px]:contents" aria-label="Episode controls">
            <div
              id="video-mode-toggle"
              class="mr-1 inline-flex items-center gap-0.5 max-[360px]:order-4 max-[360px]:basis-full max-[360px]:mr-0"
              role="group"
              aria-label="Episode view"
            >
              <button
                id="video-mode-read"
                type="button"
                class="video-mode-button flex h-10 w-10 items-center justify-center gap-1.5 rounded-md text-xs font-medium transition-[color,background-color,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60 max-[360px]:flex-1"
                aria-pressed="true"
                aria-controls="episode-video-shell"
                aria-label="Read transcript"
                title="Read transcript"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="3" width="16" height="18" rx="2" />
                  <path d="M8 8h8M8 12h8M8 16h5" />
                </svg>
                <span class="hidden max-[360px]:inline">Read</span>
              </button>
              <button
                id="video-mode-watch"
                type="button"
                class="video-mode-button flex h-10 w-10 items-center justify-center gap-1.5 rounded-md text-xs font-medium transition-[color,background-color,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60 max-[360px]:flex-1"
                aria-pressed="false"
                aria-controls="episode-video-shell"
                aria-label="Watch video"
                title="Watch video"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m10 9 5 3-5 3V9Z" />
                </svg>
                <span class="hidden max-[360px]:inline">Watch</span>
              </button>
            </div>
        </nav>
        )}
      </div>

      {videoId && videoUrl && (
        <section id="episode-video-shell" class="mx-auto w-full max-w-3xl" aria-hidden="true" inert>
          <div
            id="episode-video-sync"
            data-video-src={videoEmbedSrc}
            data-video-url={videoUrl}
            data-video-offset-seconds={videoOffsetSeconds}
          >
            <div class="relative w-full aspect-video overflow-hidden rounded-xl border border-his-hr bg-black shadow-[0_8px_24px_rgba(0,0,0,0.18)]">
              <iframe
                id="episode-youtube-player"
                class="absolute inset-0 h-full w-full"
                title={`${episodeTitle} - YouTube`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
            <a
              href={videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 block text-right text-sm text-his-text-secondary hover:text-his-green focus-visible:outline-none focus-visible:underline"
            >
              Watch on YouTube ↗
            </a>
          </div>
        </section>
      )}
    </header>

    <div id="episode-scroll-container" class="flex-1 overflow-y-auto">
    <main
      id="episode-content-shell"
      tabindex="-1"
      class="px-3 sm:px-4 pt-4 pb-4 sm:pt-6"
      data-video-layout={hasVideoPlayback ? "true" : "false"}
      data-video-mode={hasVideoPlayback ? "read" : undefined}
    >
    {headings.length > 0 && <EpisodeOutline headings={headings} />}
    <div class="episode-column">
    {hasLongDescription && (
      <details class="episode-description-disclosure mb-4 sm:hidden">
        <summary>
          <span class="episode-description-copy block text-[15px] leading-relaxed text-his-text">
            {frontmatter.description}
          </span>
          <span class="episode-description-more mt-0.5 block text-xs text-his-green">More</span>
          <span class="episode-description-less mt-0.5 hidden text-xs text-his-green">Less</span>
        </summary>
      </details>
    )}
    <p class:list={["mb-4 text-[15px] leading-relaxed text-his-text", hasLongDescription && "hidden sm:block"]}>
      {frontmatter.description}
    </p>

    {related.length > 0 && (
      <aside aria-label="Related episodes" class="episode-related">
        {related.map(({ guest, episodes }) => (
          <p>
            More with {guest.split(" ")[0]}{" · "}
            {episodes.map((ep, i) => (
              <>
                {i > 0 && " · "}
                <a href={`/${ep.slug}`} class="text-his-text-secondary hover:text-his-green transition-colors">
                  {ep.data.title}
                </a>
              </>
            ))}
          </p>
        ))}
      </aside>
    )}

    <TableOfContents headings={headings} extractedLinks={extractedLinks} />

    <div class="min-w-0">
      {hasBody
        ? <Content />
        : <p class="py-8 text-center text-sm text-his-text-secondary">Transcript coming soon. You can listen to the episode.</p>}
    </div>
    <nav class="episode-neighbors" aria-label="Neighbouring episodes">
      {neighbors.map(({ label, episode: neighbor }) => neighbor
        ? (
          <a href={`/${neighbor.slug}`} class="episode-neighbor">
            <span class="episode-neighbor-label">{label}</span>
            <span class="episode-neighbor-title">{neighbor.data.title}</span>
            {neighbor.data.guests.length > 0 && <span class="episode-neighbor-guests">{neighbor.data.guests.join(", ")}</span>}
          </a>
        )
        : <span />)}
    </nav>
    <p class="episode-listen">
      <a href={hisMetadata.apple} target="_blank" rel="noreferrer">Apple Podcasts</a>
      <span aria-hidden="true"> · </span>
      <a href={hisMetadata.spotify} target="_blank" rel="noreferrer">Spotify</a>
      <span aria-hidden="true"> · </span>
      <a href={hisMetadata.rss} target="_blank" rel="noopener noreferrer">RSS</a>
    </p>
    </div>
    </main>
    </div>
    <div class="audio-player-dock relative shrink-0 bg-his-bg">
      <button id="now-playing" type="button" class="now-playing">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
        Now playing
      </button>
      <AudioPlayer title={episodeTitle} src={audioSource} />
    </div>
  </div>

  {hasVideoPlayback && <script src="../scripts/video-player.ts"></script>}
  <script src="../scripts/episode.ts"></script>
  <script src="../scripts/reading-position.ts"></script>
</Layout>

<style>
  .episode-back {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-his-text-secondary);
  }
  .episode-back:hover { color: var(--color-his-green); }
  .episode-related { margin: -0.5rem 0 1rem; font-size: 0.8125rem; line-height: 1.5; color: var(--color-his-text-tertiary); }
  .episode-related p + p { margin-top: 0.25rem; }
  .episode-header-line h1 { flex: 0 1 auto; min-width: 6rem; margin: 0; }
  .episode-header-meta { flex: 0 1000 auto; min-width: 0; overflow: hidden; }
  .episode-back:focus-visible { outline: 2px solid var(--color-his-green); outline-offset: 2px; border-radius: 4px; }

  .episode-neighbors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-his-hr);
  }
  .episode-neighbor { display: block; color: var(--color-his-text); text-decoration: none; }
  .episode-neighbor:last-child { text-align: right; }
  .episode-neighbor:focus-visible { outline: 2px solid var(--color-his-green); outline-offset: 4px; border-radius: 4px; }
  .episode-neighbor-label {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--color-his-text-tertiary);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .episode-neighbor-title { display: block; font-size: 0.9375rem; font-weight: 550; line-height: 1.35; text-wrap: balance; }
  .episode-neighbor:hover .episode-neighbor-title { color: var(--color-his-green); }
  .episode-neighbor-guests { display: block; margin-top: 0.1rem; color: var(--color-his-text-tertiary); font-size: 0.8125rem; }

  .now-playing {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--color-his-chat-bg);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-his-green) 45%, transparent), 0 4px 14px rgb(0 0 0 / 0.18);
    color: var(--color-his-green);
    font-size: 0.75rem;
    font-weight: 550;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.4rem);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .now-playing svg { transition: transform 0.2s ease; }
  :global(#episode-shell[data-playback="playing"]:is([data-follow="above"], [data-follow="below"])) .now-playing {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  :global(#episode-shell[data-follow="above"]) .now-playing svg { transform: rotate(180deg); }
  .now-playing:hover { background: var(--color-his-hover); }
  .now-playing:focus-visible { outline: 2px solid var(--color-his-green); outline-offset: 2px; }

  @media (hover: hover) {
    :global(#episode-shell .message) { transition: opacity 0.4s ease; }
  }
  :global(#episode-shell[data-playback="playing"][data-follow="here"] .message:not(.message-current, :hover, :focus-within)) { opacity: 0.62; }

  .episode-listen {
    margin: 2.5rem 0 0;
    text-align: center;
    color: var(--color-his-text-tertiary);
    font-size: 0.75rem;
  }
  .episode-listen a { color: var(--color-his-text-secondary); }
  .episode-listen a:hover { color: var(--color-his-green); }

  .episode-description-disclosure summary {
    list-style: none;
    cursor: pointer;
  }

  .episode-description-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .episode-description-disclosure:not([open]) .episode-description-copy {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .episode-description-disclosure[open] .episode-description-more,
  .episode-description-disclosure:not([open]) .episode-description-less {
    display: none;
  }

  .episode-description-disclosure[open] .episode-description-less {
    display: block;
  }

  .episode-description-disclosure summary:focus-visible {
    outline: 2px solid var(--color-his-green);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
