---
import HomeContentLayout from "@/layouts/HomeContentLayout.astro";
import ArchiveEpisodeRow from "@/components/ArchiveEpisodeRow.astro";
import { getEpisodeData } from "@/lib/episodes";
import { episodeMoments, formatMomentTime } from "@/lib/moments";

const episodeData = await getEpisodeData();
const moments = episodeData.episodes
  .flatMap((episode) => episodeMoments(episode).map((moment) => ({ ...moment, episode })))
  .toSorted((a, b) => b.episode.data.date.getTime() - a.episode.data.date.getTime() || b.episode.number - a.episode.number)
  .map((moment) => ({
    ...moment,
    slug: moment.episode.slug,
    episodeTitle: moment.episode.data.title,
    time: formatMomentTime(moment.seconds),
    groupedBefore: moment.before.speaker === moment.speaker,
    groupedAfter: moment.after?.speaker === moment.speaker,
  }));
const initialSlots = moments.map((_, index) =>
  index === 0 ? "focus" : index === 1 ? "up-next" : index === moments.length - 1 ? "previous" : undefined
);
---

<HomeContentLayout>
  <section id="home-moments" aria-label="Moments from Hope in Source conversations">
    {moments.map((moment, index) => (
      <div
        class="home-moment"
        data-moment
        data-title={moment.episodeTitle}
        data-slot={initialSlots[index]}
      >
        <button
          class="home-moment-preview message"
          data-side={moment.side}
          type="button"
          data-preview
          aria-label={`Show conversation from ${moment.episodeTitle}`}
        >
          <b>{moment.speaker}</b>
          <span class="message-bubble">{moment.preview ?? moment.text}<time>{moment.time}</time></span>
          <span class="home-moment-teaser-label">
            <span data-teaser-direction>{index === 1 ? "Up next" : "Previous"}</span>
            <span aria-hidden="true">·</span>
            <span class="home-moment-teaser-title">{moment.episodeTitle}</span>
          </span>
        </button>
        <div class="home-moment-conversation">
          <a
            class="home-moment-context message"
            data-side={moment.before.side}
            data-run={moment.groupedBefore ? "start" : undefined}
            href={`/${moment.slug}#${moment.before.id}`}
          >
            <b>{moment.before.speaker}</b>
            <span class="message-bubble">{moment.before.text}<time>{formatMomentTime(moment.before.seconds)}</time></span>
          </a>
          <a
            class="home-moment-link message"
            data-side={moment.side}
            data-run={moment.groupedBefore ? (moment.groupedAfter ? "mid" : "end") : moment.groupedAfter ? "start" : undefined}
            href={`/${moment.slug}#${moment.id}`}
            aria-label={`${moment.speaker} in ${moment.episodeTitle}: ${moment.text} At ${moment.time}.`}
          >
            {!moment.groupedBefore && <b>{moment.speaker}</b>}
            <span class="message-bubble"><span class="home-moment-text">{moment.text}</span><time>{moment.time}</time></span>
          </a>
          {moment.after && (
            <a
              class="home-moment-context message"
              data-side={moment.after.side}
              data-run={moment.groupedAfter ? "end" : undefined}
              href={`/${moment.slug}#${moment.after.id}`}
            >
              {!moment.groupedAfter && <b>{moment.after.speaker}</b>}
              <span class="message-bubble">{moment.after.text}<time>{formatMomentTime(moment.after.seconds)}</time></span>
            </a>
          )}
          <a class="home-moment-source" href={`/${moment.slug}#${moment.id}`}>
            <b>{moment.episodeTitle}</b> <span aria-hidden="true">·</span> read from here <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    ))}
    <span class="sr-only" aria-live="polite" data-status></span>
  </section>

  <canvas id="home-roots" slot="below" aria-hidden="true"></canvas>
  <section id="episodes" slot="below" aria-labelledby="episodes-title">
    <h2 id="episodes-title" class="sr-only">Episodes</h2>
    {episodeData.archiveGroups.map((group, groupIndex) => (
      <section class="archive-season" id={`home-season-${group.id}`} aria-labelledby={`season-title-${group.id}`}>
        <div class="archive-season-heading">
          <h3 id={`season-title-${group.id}`}>{group.label}</h3>
          <span>{group.episodes.length} {group.episodes.length === 1 ? "episode" : "episodes"}</span>
        </div>
        <div class="archive-episode-list">
          {group.episodes.map((episode, episodeIndex) => (
            <ArchiveEpisodeRow episode={episode} showDescription={episodeIndex < (groupIndex === 0 ? 2 : 1)} />
          ))}
        </div>
      </section>
    ))}
  </section>

  <script src="../scripts/home-showcase.ts"></script>
  <script src="../scripts/resume-mark.ts"></script>
  <script src="../scripts/home-roots.ts"></script>
</HomeContentLayout>

<style>
  #home-roots {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #episodes {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    margin: 0 auto;
    padding: 3rem 0.75rem 6rem;
    scroll-margin-top: 0;
  }
  .archive-season + .archive-season { margin-top: 1.5rem; }
  .archive-season-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
    padding-inline: 0.65rem;
  }
  .archive-season-heading h3 {
    margin: 0;
    color: var(--color-his-text);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .archive-season-heading > span {
    flex: none;
    color: var(--color-his-text-tertiary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .archive-episode-list { display: grid; }
  @media (min-width: 960px) {
    #episodes { max-width: 70rem; padding-inline: 1.5rem; }
    .archive-season + .archive-season { margin-top: 3rem; }
    .archive-season-heading { margin-bottom: 0.9rem; padding-inline: 0.15rem; }
    .archive-season-heading h3 { font-size: 1.5rem; font-weight: 500; }
    .archive-episode-list { grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.6rem; }
  }

  #home-moments {
    display: grid;
    grid-template-rows: 6rem auto 6rem;
    row-gap: 1.75rem;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
    padding-block: 1rem 2rem;
    touch-action: pan-y;
  }

  @media (min-width: 960px) {
    #home-moments {
      flex: 1;
      align-content: center;
    }
  }

  .home-moment { display: contents; color: var(--color-his-text); }
  .home-moment .message { max-width: 100%; }
  .home-moment a { color: var(--color-his-text); text-decoration: none; }

  .home-moment-preview { display: none; }
  .home-moment:is([data-slot="previous"], [data-slot="up-next"]) .home-moment-preview {
    display: flex;
    flex-direction: column;
    grid-row: 1;
    grid-column: 1;
    align-self: end;
    width: min(26rem, 80%);
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 160ms ease;
  }
  .home-moment[data-slot="up-next"] .home-moment-preview { grid-row: 3; align-self: start; }
  .home-moment-preview:hover,
  .home-moment-preview:focus-visible { opacity: 1; }
  .home-moment-preview .message-bubble {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.875rem;
  }
  .home-moment-preview time { display: none; }
  .home-moment-teaser-label {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-top: 0.35rem;
    padding-inline: 0.25rem;
    color: var(--color-his-text-secondary);
    font-size: 0.7rem;
  }
  .home-moment-teaser-title { color: var(--color-his-text); }

  .home-moment-conversation {
    display: flex;
    flex-direction: column;
    justify-content: center;
    grid-row: 2;
    grid-column: 1;
    visibility: hidden;
  }
  .home-moment[data-slot="focus"] .home-moment-conversation { visibility: visible; }
  .home-moment-context { max-width: 92%; }
  .home-moment-context .message-bubble { font-size: 0.94rem; }
  .home-moment-link .message-bubble { font-size: 1.25rem; line-height: 1.45; }

  .home-moment .home-moment-source {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 40px;
    margin-top: 0.35rem;
    padding-inline: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-his-text-secondary);
  }
  .home-moment-source b { font-weight: 500; color: var(--color-his-text); }
  .home-moment .home-moment-source:hover { color: var(--color-his-green); }
  .home-moment-source:hover b { color: inherit; }

  .home-moment :is(.home-moment-link, .home-moment-context, .home-moment-preview):focus-visible { outline: none; }
  .home-moment :is(.home-moment-link, .home-moment-context, .home-moment-preview):focus-visible .message-bubble {
    box-shadow: inset 0 0 0 2px var(--color-his-green);
  }
  .home-moment-source:focus-visible { outline: 2px solid var(--color-his-green); outline-offset: 2px; border-radius: 2px; }

  @media (max-width: 639px) {
    #home-moments { grid-template-rows: 4.75rem auto 4.75rem; row-gap: 1.25rem; }
    .home-moment-link .message-bubble { font-size: 1.06rem; }
    .home-moment-preview .message-bubble { -webkit-line-clamp: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-moment-preview { transition: none; }
  }
</style>
