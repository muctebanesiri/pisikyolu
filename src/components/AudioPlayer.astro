---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div
  class="relative z-40 mx-auto my-1.5 w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] max-w-xl text-his-text"
  id="audio-player-container"
  data-src={src}
  data-audio-state="idle"
  role="region"
  aria-label={`${title} audio player`}
>
  <span class="sr-only">{title}</span>
  <div class="px-3 sm:px-4">
    <div class="flex items-center gap-2 sm:gap-4">
      <button
        id="play-pause"
        class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-his-green/10 text-his-green transition-[color,background-color,transform] duration-200 hover:bg-his-green/20 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60"
        aria-label="Play episode"
      >
        <svg id="play-icon" class="h-4 w-4 translate-x-px" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M4 2.5v11l9.5-5.5z" />
        </svg>
        <svg id="pause-icon" class="h-4 w-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" />
        </svg>
        <span id="play-label" class="text-sm font-mono tabular-nums"></span>
      </button>
      <div id="mute-controls" class="hidden sm:flex group items-center">
        <button
          id="mute-button"
          class="flex h-10 w-10 items-center justify-center rounded-lg text-his-text-secondary transition-[color,background-color] duration-200 hover:bg-his-hover hover:text-his-green focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60"
          aria-label="Mute"
        >
          <svg id="volume-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
          </svg>
          <svg id="mute-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75 19.5 12m0 0 2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6 4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
          </svg>
        </button>
        <div class="w-0 overflow-hidden transition-[width] duration-200 group-hover:w-24 group-focus-within:w-24 flex items-center">
          <input
            type="range"
            id="volume-slider"
            class="w-full h-2 mx-2 appearance-none bg-his-text-tertiary/50 rounded-full"
            aria-label="Episode volume"
            aria-valuetext="50 percent"
            min="0"
            max="100"
            value="50"
          />
        </div>
      </div>
      <span id="current-time" class="min-w-11 whitespace-nowrap text-sm font-mono tabular-nums text-his-text-secondary"
        >00:00</span
      >
      <div id="seek-controls" class="flex-grow relative h-10 group">
        <div class="absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 rounded-full bg-his-text-tertiary/50"></div>
        <div
          id="progress-bar"
          class="absolute left-0 top-1/2 h-2 w-0 -translate-y-1/2 rounded-full bg-his-green/40 transition-[width] duration-100"
        >
        </div>
        <input
          type="range"
          id="seek-slider"
          class="absolute inset-0 m-0 h-full w-full cursor-pointer appearance-none bg-transparent opacity-0 transition-opacity group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none"
          step="0.01"
          aria-label="Episode position"
          aria-valuetext="00:00 of 00:00"
          min="0"
          max="100"
          value="0"
          disabled
        />
      </div>
      <span id="duration" class="min-w-11 whitespace-nowrap text-right text-sm font-mono tabular-nums text-his-text-secondary"
        >00:00</span
      >
      <button
        id="shortcuts-button"
        class="hidden sm:flex h-10 w-10 items-center justify-center rounded-lg text-his-text-secondary transition-[color,background-color] duration-200 hover:bg-his-hover hover:text-his-green focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60"
        aria-label="Keyboard shortcuts"
        popovertarget="shortcuts-popover"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
      </button>
    </div>
  </div>
  <audio id="audio-element" preload="none"></audio>
</div>

<!-- Seek feedback popup -->
<div
  id="player-feedback"
  class="absolute left-1/2 -translate-x-1/2 bottom-full mb-2 z-40 whitespace-nowrap bg-his-hover/95 text-his-text px-4 py-2 rounded-lg border border-his-text-tertiary/50 backdrop-blur-sm opacity-0 transition-opacity duration-200 pointer-events-none flex items-center gap-2"
  role="status"
  aria-live="polite"
>
  <span id="feedback-text" class="text-sm"></span>
</div>

<dl id="shortcuts-popover" popover aria-label="Keyboard shortcuts">
  <dt><kbd>space</kbd></dt><dd>Play / pause</dd>
  <dt><kbd>j</kbd></dt><dd>Next message</dd>
  <dt><kbd>k</kbd></dt><dd>Previous message</dd>
  <dt><kbd>m</kbd></dt><dd>Mute</dd>
</dl>

<script src="../scripts/audio-player.ts"></script>

<style>
  #audio-player-container[data-audio-state="idle"] {
    width: max-content;
  }

  #audio-player-container[data-audio-state="idle"] > div {
    padding-inline: 0;
  }

  #audio-player-container[data-audio-state="idle"] #play-pause:has(#play-label:not(:empty)) {
    width: auto;
    gap: 0.45rem;
    padding-inline: 0.9rem;
  }

  #play-label:empty {
    display: none;
  }

  #shortcuts-button {
    anchor-name: --shortcuts;
  }

  #shortcuts-popover {
    position-anchor: --shortcuts;
    position-try-fallbacks: flip-block;
    inset: auto;
    top: anchor(bottom);
    right: anchor(right);
    margin: 0.4rem 0;
    display: none;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.45rem 0.75rem;
    padding: 0.75rem 0.9rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--color-his-chat-bg);
    color: var(--color-his-text);
    font-size: 0.8125rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }

  #shortcuts-popover:popover-open {
    display: grid;
  }

  #shortcuts-popover dt {
    justify-self: end;
  }

  #shortcuts-popover dd {
    margin: 0;
    color: var(--color-his-text-secondary);
  }

  #shortcuts-popover kbd {
    font: 0.75rem/1 ui-monospace, monospace;
    padding: 0.2rem 0.4rem;
    border-radius: 0.3rem;
    background: var(--color-his-hover);
  }

  #audio-player-container[data-audio-state="idle"] :is(#mute-controls, #current-time, #seek-controls, #duration, #shortcuts-button),
  #audio-player-container[data-audio-state="active"] #play-label {
    display: none;
  }

  #seek-slider::-webkit-slider-runnable-track {
    height: 12px;
    background: transparent;
  }

  #seek-slider::-moz-range-track {
    height: 12px;
    background: transparent;
  }

  #seek-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: var(--color-his-green);
    cursor: pointer;
  }

  #seek-slider::-moz-range-thumb {
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: var(--color-his-green);
    cursor: pointer;
    border: none;
  }

  #seek-slider:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-his-green) 35%, transparent);
  }

  #seek-slider:focus-visible::-moz-range-thumb {
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-his-green) 35%, transparent);
  }

  /* Volume slider styles */
  #volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    margin-top: -4px;
  }

  #volume-slider::-moz-range-thumb {
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: white;
    cursor: pointer;
    border: none;
  }

  #volume-slider::-webkit-slider-runnable-track {
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  #volume-slider::-moz-range-track {
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  #volume-slider {
    background: linear-gradient(to right, rgba(255, 255, 255, 0.4) 50%, rgba(255, 255, 255, 0.2) 50%);
    border-radius: 2px;
  }
</style>
