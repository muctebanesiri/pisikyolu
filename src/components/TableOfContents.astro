---
import type { ExtractedLink } from "@/markdown/links";

interface TOCHeading {
  slug: string;
  text: string;
}

interface Props {
  headings: TOCHeading[];
  extractedLinks?: ExtractedLink[];
}

const { headings, extractedLinks = [] } = Astro.props;
const hasContent = headings.length > 0 || extractedLinks.length > 0;
---

{hasContent && (
  <>
    {headings.length > 0 && (
      <details
        id="mobile-chapters"
        class="mobile-chapters sticky top-2 z-[45] mb-5 rounded-xl border border-his-hr bg-his-bg/95 shadow-sm backdrop-blur-sm"
      >
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-3 text-sm font-medium text-his-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60">
          <span class="min-w-0 truncate">
            <span class="text-his-text-tertiary">Chapters</span>
            <span aria-hidden="true"> · </span>
            <span id="mobile-chapters-current">{headings[0].text}</span>
          </span>
          <span class="flex-shrink-0 text-xs tabular-nums text-his-text-tertiary">{headings.length}</span>
        </summary>
        <nav aria-label="Episode chapters" class="max-h-[min(50vh,24rem)] overflow-y-auto border-t border-his-hr p-1.5">
          <ul class="list-none space-y-0.5">
            {headings.map((heading) => (
              <li class="m-0">
                <a
                  href={`#${heading.slug}`}
                  class="toc-link chapter-link flex min-h-11 items-center rounded-lg px-2.5 text-sm font-medium text-his-text no-underline transition-[color,background-color] duration-200 hover:bg-his-hover hover:text-his-text"
                  data-heading-id={heading.slug}
                >
                  <span class="toc-title min-w-0">{heading.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}

    <!-- References (tablet+, right side) -->
    <div
      id="toc-scrubber"
      class="hidden md:flex fixed right-3 top-1/2 -translate-y-1/2 flex-col items-end gap-1.5 p-2 z-40"
    >
      {/* Reference count badge - vertical layout */}
      {extractedLinks.length > 0 && (
        <button
          id="ref-badge"
          type="button"
          class="flex min-h-10 min-w-10 flex-col items-center justify-center gap-0.5 text-[10px] text-his-text-tertiary hover:text-his-green transition-colors cursor-pointer rounded-md p-1 bg-transparent border-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60"
          aria-label="Toggle references"
          aria-controls="ref-popover"
          aria-expanded="false"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          <span class="font-medium">{extractedLinks.length}</span>
        </button>
      )}
    </div>

    <!-- References popover -->
    {extractedLinks.length > 0 && (
      <div
        id="ref-popover"
        class="hidden md:block fixed right-12 top-1/2 w-72 overflow-hidden bg-his-bg border border-his-hr rounded-lg shadow-xl opacity-0 invisible transition-[opacity,transform,visibility] duration-200 z-50"
        style="transform: translateY(-50%) translateX(10px);"
      >
        <div class="p-1.5 max-h-[60vh] overflow-y-auto overscroll-contain [scrollbar-width:thin]">
          {extractedLinks.map((link) => (
            <div
              class="ref-popover-item py-2 px-2 rounded-md hover:bg-his-hover/50 transition-colors"
            >
              <a
                href={`#ref-${link.blockquoteIndex}`}
                class="ref-passage-link block rounded-sm text-sm text-his-text leading-relaxed mb-1 line-clamp-2 no-underline hover:text-his-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-his-green/60"
              >
                {link.quoteText?.slice(0, 120) || "Passage"}{link.quoteText && link.quoteText.length > 120 ? '...' : ''}
              </a>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs text-his-green hover:underline"
              >
                <svg class="w-3 h-3 flex-shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span>{link.text}</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    )}
  </>
)}

<script>
  let currentActiveId: string | null = null;
  let refOpen = false;
  let tocInitialized = false;

  function handleTOCClick(e: MouseEvent) {
    const target = e.target as HTMLElement;
    const refPopover = document.getElementById('ref-popover');
    const refBadge = document.getElementById('ref-badge');
    if (refOpen && !refPopover?.contains(target) && !refBadge?.contains(target)) {
      closeRefPopover();
    }
  }

  function handleTOCKeyDown(e: KeyboardEvent) {
    if (e.key === 'Escape') closeRefPopover(true);
  }

  function closeRefPopover(restoreFocus = false) {
    const refPopover = document.getElementById('ref-popover');
    const refBadge = document.getElementById('ref-badge');
    refPopover?.classList.remove('opacity-100');
    refPopover?.classList.add('invisible', 'opacity-0');
    refPopover?.style.setProperty('transform', 'translateY(-50%) translateX(10px)');
    refBadge?.setAttribute('aria-expanded', 'false');
    if (restoreFocus && refOpen && refPopover?.contains(document.activeElement)) refBadge?.focus();
    refOpen = false;
  }

  function initTOC() {
    tocInitialized = true;
    const tocLinks = document.querySelectorAll('.toc-link');

    const refBadge = document.getElementById('ref-badge');
    const refPopover = document.getElementById('ref-popover');
    const mobileChapters = document.getElementById('mobile-chapters') as HTMLDetailsElement | null;
    const mobileChaptersCurrent = document.getElementById('mobile-chapters-current');

    function setActive(id: string) {
      const target = document.getElementById(id);
      if (!target?.matches('h2')) return;
      if (currentActiveId === id) return;
      currentActiveId = id;
      if (mobileChaptersCurrent && target.textContent) {
        mobileChaptersCurrent.textContent = target.textContent.trim();
      }

      tocLinks.forEach(link => {
        const isActive = link.getAttribute('data-heading-id') === id;
        link.classList.toggle('active', isActive);
        link.classList.toggle('text-his-green', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
          const outline = link.closest<HTMLElement>('.episode-outline');
          if (outline?.offsetParent) {
            const box = outline.getBoundingClientRect();
            const row = link.getBoundingClientRect();
            if (row.top < box.top) outline.scrollTop += row.top - box.top;
            else if (row.bottom > box.bottom) outline.scrollTop += row.bottom - box.bottom;
          }
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    function openRefPopover() {
      refPopover?.classList.remove('invisible', 'opacity-0');
      refPopover?.classList.add('opacity-100');
      refPopover?.style.setProperty('transform', 'translateY(-50%) translateX(0)');
      refBadge?.setAttribute('aria-expanded', 'true');
      refOpen = true;
    }

    refBadge?.addEventListener('click', (e) => {
      e.stopPropagation();
      refOpen ? closeRefPopover() : openRefPopover();
    });

    tocLinks.forEach(link => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href');
        if (href) {
          const target = document.querySelector(href);
          if (target) {
            mobileChapters?.removeAttribute('open');
            setActive(href.slice(1));
            (target as HTMLElement).tabIndex = -1;
            requestAnimationFrame(() => (target as HTMLElement).focus({ preventScroll: true }));
          }
        }
      });
    });

    refPopover?.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('.ref-passage-link');
      if (!link) return;
      closeRefPopover();
      const passage = document.getElementById(link.hash.slice(1));
      if (!passage) return;
      passage.classList.add('ref-highlight');
      passage.tabIndex = -1;
      requestAnimationFrame(() => passage.focus({ preventScroll: true }));
      setTimeout(() => passage.classList.remove('ref-highlight'), 1500);
    });

    // Enrich TOC links with timestamps from adjacent messages
    document.querySelectorAll('#episode-content-shell h2').forEach((heading) => {
      let el = heading.nextElementSibling;
      while (el && !el.matches('[data-timestamp]') && !el.querySelector('[data-timestamp]') && !el.matches('h2')) {
        el = el.nextElementSibling;
      }
      const timed = el?.matches('[data-timestamp]') ? el : el?.querySelector('[data-timestamp]');
      if (timed) {
        const seconds = parseInt(timed.getAttribute('data-timestamp') || '0', 10);
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        const timeStr = `${mins}:${secs.toString().padStart(2, '0')}`;

        const matchingLinks = document.querySelectorAll(`.toc-link[data-heading-id="${heading.id}"]`);
        matchingLinks.forEach((tocLink) => {
          if (tocLink.querySelector('.toc-time')) return;
          const timeSpan = document.createElement('time');
          timeSpan.className = 'toc-time';
          timeSpan.dateTime = `PT${seconds}S`;
          timeSpan.textContent = timeStr;
          tocLink.appendChild(timeSpan);
        });
      }
    });

    const chapterHeadings = [...document.querySelectorAll<HTMLElement>('#episode-content-shell h2')];
    const scroller = document.getElementById('episode-scroll-container');
    let chapterFrame = 0;
    const markChapterInView = () => {
      chapterFrame = 0;
      const box = scroller?.getBoundingClientRect();
      const top = box?.top ?? 0;
      const height = box?.height ?? window.innerHeight;
      const atEnd = scroller
        ? scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2
        : window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      const line = top + height * 0.3;
      const current = atEnd
        ? chapterHeadings.at(-1)
        : chapterHeadings.filter((h) => h.getBoundingClientRect().top <= line).at(-1);
      if (current) setActive(current.id);
    };
    (scroller ?? window).addEventListener('scroll', () => {
      chapterFrame ||= requestAnimationFrame(markChapterInView);
    }, { passive: true });
    markChapterInView();

    document.addEventListener('click', handleTOCClick);
    document.addEventListener('keydown', handleTOCKeyDown);

    const hash = window.location.hash;
    if (hash) {
      const id = hash.slice(1);
      const target = document.getElementById(id);
      if (target?.matches('h2')) setActive(id);
      else {
        const seconds = id.startsWith('t=') ? Number(id.slice(2)) : null;
        const passage = target ?? (seconds !== null && Number.isFinite(seconds)
          ? [...document.querySelectorAll<HTMLElement>('.message[data-timestamp]')]
            .filter(m => Number(m.dataset.timestamp) <= seconds).at(-1) : null);
        if (passage) {
          const heading = [...document.querySelectorAll('#episode-content-shell h2')].filter(h =>
            Boolean(h.compareDocumentPosition(passage) & Node.DOCUMENT_POSITION_FOLLOWING)).at(-1);
          if (heading) setActive(heading.id);
        }
      }
    }
  }

  function initTOCLazyBootstrap() {
    const refBadge = document.getElementById('ref-badge');
    const mobileChapters = document.getElementById('mobile-chapters');
    const scrollContainer = document.getElementById('episode-scroll-container');

    const warmInit = () => {
      if (tocInitialized) return;
      initTOC();
    };

    mobileChapters?.addEventListener('toggle', () => {
      warmInit();
      if ((mobileChapters as HTMLDetailsElement).open) {
        const scrollContainer = document.getElementById('episode-scroll-container');
        if (!scrollContainer) return;
        const containerRect = scrollContainer.getBoundingClientRect();
        const detailsRect = mobileChapters.getBoundingClientRect();
        const targetTop = Math.max(
          0,
          scrollContainer.scrollTop + detailsRect.top - containerRect.top - 8,
        );
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
        scrollContainer.scrollTo({ top: targetTop, behavior });
      }
    });

    // The margin outline is on screen from the start, so its times and current mark can't wait for a scroll.
    if (document.querySelector<HTMLElement>('.episode-outline')?.offsetParent) {
      warmInit();
      return;
    }

    const handleFirstControlClick = (e: Event) => {
      const control = e.currentTarget as HTMLElement | null;
      if (!control) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      warmInit();
      queueMicrotask(() => control.click());
    };

    refBadge?.addEventListener('click', handleFirstControlClick, { capture: true, once: true });
    scrollContainer?.addEventListener('scroll', warmInit, { passive: true, once: true });
    if (!scrollContainer) {
      window.addEventListener('scroll', warmInit, { passive: true, once: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTOCLazyBootstrap, { once: true });
  } else {
    initTOCLazyBootstrap();
  }
</script>
