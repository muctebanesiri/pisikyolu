---
import Layout from "@/layouts/Layout.astro";
import ListenLinks from "@/components/ListenLinks.astro";

const taglines = [
  "off-the-cuff conversations between friends",
  "finding the sacred in the ordinary",
  "universal within the particular",
  "where word becomes flesh",
];
---

<Layout frontmatter={{}} slug="/" mainId="home-layout-stage">
  <script is:inline>
    document.documentElement.dataset.scene = "live";
  </script>
  <canvas id="home-scene" aria-hidden="true"></canvas>
  <div id="home-layout-root" class="home-root">
    <header id="home-brand">
      <div class="brand-inner">
        <h1 class="brand-title"><i>Hope in</i> Source</h1>
        <p class="brand-hosts">
          with <a href="https://nadia.xyz/public-faith">Nadia</a> & <a href="https://henryzoo.com/living-out-in-faith">Henry</a>
        </p>
        <div id="home-plot" class="brand-plot"></div>
        <ul class="brand-taglines" aria-label="About the show">
          {taglines.map((line, index) => (
            <li data-on={index === 0 ? "" : undefined}>
              {line.split(" ").map((word, i) => <><span style={`--i:${i}`}>{word}</span>{" "}</>)}
            </li>
          ))}
        </ul>
      </div>
    </header>

    <nav id="home-top-controls" aria-label="Site navigation">
      <a href="#episodes" class="home-view-button">Episodes</a>
      <ListenLinks />
    </nav>

    <main id="home-layout-stage" tabindex="-1">
      <slot />
    </main>
  </div>
  <slot name="below" />
  <script src="../scripts/home-scene.ts"></script>
</Layout>
